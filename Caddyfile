# Chain: NAS edge (public TLS) -> mainserv nginx (LAN, plain HTTP) -> here.
# Trusting the private-range hop keeps the X-Forwarded-Proto: https and the real
# client IP those proxies set, instead of rewriting them from this connection.
{
  servers {
    trusted_proxies static private_ranges
  }
}

:4540 {
  encode gzip zstd
  log {
    output stdout
    format json
  }
  handle /api/* {
    reverse_proxy backend:8000
  }
  handle /docs* {
    reverse_proxy backend:8000
  }
  handle /openapi.json {
    reverse_proxy backend:8000
  }
  handle {
    reverse_proxy frontend:80
  }
}
