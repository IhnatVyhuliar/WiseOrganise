GEMINI_API_KEY=
GEMINI_MODEL_MAIN=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
USE_MOCK_AI=true
# Per-call timeout for live Gemini requests, in seconds.
GEMINI_TIMEOUT_SECONDS=45
# Origin used to build share links: {PUBLIC_BASE_URL}/w/{slug}.
PUBLIC_BASE_URL=https://wiseorganise.reachit.space
# Address the edge proxy port is published on. mainserv's nginx reaches the app
# over loopback; set 0.0.0.0 only to reach the stack from another machine.
EDGE_BIND_ADDR=127.0.0.1
# PostgreSQL. The db service is only reachable on the compose network.
POSTGRES_PASSWORD=wiseorganise
DATABASE_URL=postgresql://wiseorganise:wiseorganise@db:5432/wiseorganise
