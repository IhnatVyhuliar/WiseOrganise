# TLS variant used only behind the LAN edge proxy; see docker-compose.lan.yml.
#
# The edge terminates the public name and re-proxies with proxy_pass https://,
# proxy_ssl_name lan-backend.internal and proxy_ssl_verify on against a pinned
# CA. Caddy therefore has to present the pair make-cert.sh issued for that SAN;
# its own internal CA would fail verification and the edge would answer 502.
{
	auto_https off
	servers {
		# The edge is the only hop allowed to set X-Forwarded-*. Docker publishes
		# the port with DNAT and keeps the source address, so Caddy sees the real
		# 192.168.0.2 rather than the bridge gateway.
		trusted_proxies static 192.168.0.2/32
	}
}

# Deliberately a catch-all address, not the public name: it matches the Host the
# edge sends AND direct LAN access by IP. Naming the host here would break both
# localhost and IP access for no gain.
:4540 {
	tls /certs/fullchain.pem /certs/privkey.pem
	encode gzip zstd
	log {
		output stdout
		format json
	}
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:80
	}
}
